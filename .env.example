# Discord application: https://discord.com/developers/applications
# Bot -> Reset Token. Keep it secret: anyone holding it is your bot.
DISCORD_TOKEN=
# General Information -> Application ID.
DISCORD_APP_ID=
# Optional. A server id registers /price there at once; leave it empty to
# register it globally (Discord takes up to an hour to show it everywhere).
DISCORD_GUILD_ID=

# alltcgapi key (atcg_live_...). Get one at https://alltcgapi.com/free-api-key.
ALLTCG_API_KEY=
# Optional. Defaults to https://api.alltcgapi.com.
ALLTCG_BASE_URL=
